.header {
  border: 1px solid #eee;
  border-radius: 12px;
  padding: 0.75rem;
  background: #fff;
}

.name {
  font-size: 1.05rem;
  font-weight: 800;
  margin-bottom: 0.4rem;
}

.line {
  display: flex;
  gap: 0.35rem;
  margin: 0.2rem 0;
  flex-wrap: wrap;
}

.label {
  font-weight: 700;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.5rem;
}

.tile {
  border: 1px solid #e5e7eb;
  background: #fff;
  border-radius: 12px;
  padding: 0.65rem 0.6rem;
  font-size: 0.85rem;
  cursor: pointer;
  text-align: center;
}

.tile.active {
  border-color: #c7a10a;
  background: #fff9db;
  font-weight: 800;
}

.sectionTitle {
  font-weight: 800;
  margin-bottom: 0.5rem;
}

.kv {
  border: 1px solid #eee;
  border-radius: 12px;
  padding: 0.65rem;
  margin-bottom: 0.5rem;
  background: #fff;
}

.k {
  font-weight: 700;
  margin-bottom: 0.2rem;
}

.v {
  white-space: pre-wrap;
}
